{
  "private": true,
  "scripts": {
    "build:guidelines": "node scripts/build-event-copy-guidelines.cjs",
    "check:guidelines": "node scripts/build-event-copy-guidelines.cjs --check",
    "test:unit": "mqt-test --config scripts/unit-test-suites.cjs",
    "test:coverage": "c8 mqt-test --config scripts/unit-test-suites.cjs"
  },
  "c8": {
    "all": true,
    "include": [
      "appInit.js",
      "application/**/*.js",
      "common/**/*.js",
      "domain/**/*.js",
      "infrastructure/**/*.js",
      "util/**/*.js"
    ],
    "exclude": [
      "test/**",
      "scripts/**",
      "node_modules/**",
      "coverage/**"
    ],
    "reporter": [
      "text",
      "html",
      "json-summary",
      "json"
    ],
    "reports-dir": "coverage"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "mqt-test-runner": "file:../mqt-test-runner"
  }
}
